    "ImageData": {
      "description": "A raster image carried inline as standard base64. The bytes must start with the format's file signature (checked by both validators, not expressible here), decode to at most 8 MiB, and the whole action to at most 12 MiB. SVG is refused: it is markup, not raster bytes.",
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "png",
            "jpeg",
            "webp"
          ]
        },
        "bytes": {
          "type": "string",
          "minLength": 16,
          "maxLength": 11184812,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{4}|[A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{2}==)$"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "[^\\t\\n\\u000b\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
        },
        "title": {
