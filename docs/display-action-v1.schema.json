{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://switchboard.internal/schemas/display-action-v1.json",
  "title": "DisplayAction",
  "description": "Canonical Switchboard DisplayAction v1 specification.",
  "$comment": "Both validators (validation.ts, visual_protocol.rs) also follow rules JSON Schema cannot state: the order of their checks and of an object's keys (code point order), the one whitespace set a blank id is made of (Unicode White_Space), the size as JSON.stringify writes the action, and the exact error text. docs/display-tool.md, 'How the two validators agree', lists them; apps/frontend/tests/fixtures/validator-corpus.json pins them, and this schema accepts every action that corpus accepts.",
  "oneOf": [
    {
      "$ref": "#/definitions/ShowChartAction"
    },
    {
      "$ref": "#/definitions/ShowMetricAction"
    },
    {
      "$ref": "#/definitions/ShowProgressAction"
    },
    {
      "$ref": "#/definitions/ShowDiagramAction"
    },
    {
      "$ref": "#/definitions/ShowDocumentAction"
    },
    {
      "$ref": "#/definitions/ShowCodeAction"
    },
    {
      "$ref": "#/definitions/ShowTableAction"
    },
    {
      "$ref": "#/definitions/ShowNoteAction"
    },
    {
      "$ref": "#/definitions/ShowImageAction"
    },
    {
      "$ref": "#/definitions/ShowCalendarAction"
    },
    {
      "$ref": "#/definitions/ShowTasksAction"
    },
    {
      "$ref": "#/definitions/ShowTimerAction"
    },
    {
      "$ref": "#/definitions/ShowWeatherAction"
    },
    {
      "$ref": "#/definitions/ShowInboxAction"
    },
    {
      "$ref": "#/definitions/HideAction"
    },
    {
      "$ref": "#/definitions/FocusAction"
    },
    {
      "$ref": "#/definitions/SayAction"
    },
    {
      "$ref": "#/definitions/ClearAction"
    }
  ],
  "allOf": [
    {
      "$ref": "#/definitions/SafeValue"
    }
  ],
  "definitions": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!__runtime/)"
    },
    "Role": {
      "type": "string",
      "enum": [
        "primary",
        "compare",
        "secondary",
        "ambient"
      ]
    },
    "Semantic": {
      "type": "string",
      "enum": [
        "red",
        "orange",
        "green",
        "cyan",
        "amber",
        "paper",
        "muted"
      ]
    },
    "SafeValue": {
      "if": {
        "type": "string"
      },
      "then": {
        "type": "string",
        "not": {
          "pattern": "<[sS][cC][rR][iI][pP][tT]|<[iI][fF][rR][aA][mM][eE]|<[hH][tT][mM][lL]|<[sS][tT][yY][lL][eE]|<[sS][vV][gG]|<[oO][bB][jJ][eE][cC][tT]|<[eE][mM][bB][eE][dD]|[jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]:|[dD][aA][tT][aA]:[tT][eE][xX][tT]/[hH][tT][mM][lL]|://|^//|//[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}"
        }
      },
      "else": {
        "if": {
          "type": "array"
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SafeValue"
          }
        },
        "else": {
          "if": {
            "type": "object"
          },
          "then": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/SafeValue"
            }
          }
        }
      }
    },
    "ChartSeries": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "semantic": {
          "$ref": "#/definitions/Semantic"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "name",
        "values"
      ],
      "additionalProperties": false
    },
    "ChartMarker": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "series": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "x"
      ],
      "additionalProperties": false
    },
    "ChartData": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "subtitle": {
          "type": "string",
          "maxLength": 256
        },
        "context": {
          "type": "string",
          "maxLength": 256
        },
        "caption": {
          "type": "string",
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "line",
            "bar",
            "area",
            "scatter"
          ]
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "xLabel": {
          "type": "string",
          "maxLength": 128
        },
        "yLabel": {
          "type": "string",
          "maxLength": 128
        },
        "xMax": {
          "type": "number"
        },
        "yMin": {
          "type": "number"
        },
        "yMax": {
          "type": "number"
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChartSeries"
          }
        },
        "marker": {
          "$ref": "#/definitions/ChartMarker"
        },
        "compareLabel": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "series"
      ],
      "additionalProperties": false
    },
    "MetricData": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "maxLength": 128
        },
        "semantic": {
          "$ref": "#/definitions/Semantic"
        },
        "caption": {
          "type": "string",
          "maxLength": 128
        },
        "trend": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "flat"
