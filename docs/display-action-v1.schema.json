      "required": [
        "view",
        "start",
        "events"
      ],
      "additionalProperties": false,
      "$comment": "now falls on today when both are given: checked by both validators, not here.",
      "allOf": [
        {
          "if": {
            "properties": {
              "view": {
                "const": "week"
              }
            },
            "required": [
              "view"
            ]
          },
          "then": {
            "properties": {
              "days": {
                "type": "integer",
                "maximum": 7
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "enum": [
                  "day",
                  "month"
                ]
              }
            },
            "required": [
              "view"
            ]
          },
          "then": {
            "not": {
              "required": [
                "days"
              ]
            }
          }
        }
      ]
    },
