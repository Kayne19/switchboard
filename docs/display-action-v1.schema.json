    "DateValue": {
      "description": "YYYY-MM-DD: a real day in the years 1970-2199 (docs/display-tool.md, 'Time values'). The pattern cannot tell 2026-02-30 from a real day; both validators do.",
      "type": "string",
      "pattern": "^(?:19[7-9][0-9]|20[0-9]{2}|21[0-9]{2})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "WallTimeValue": {
      "description": "YYYY-MM-DDTHH:MM: the caller's wall clock, 24 h, no seconds and no offset, drawn as written.",
      "type": "string",
      "pattern": "^(?:19[7-9][0-9]|20[0-9]{2}|21[0-9]{2})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "InstantValue": {
      "description": "RFC 3339 with seconds and an offset (Z or +HH:MM/-HH:MM), upper-case T and Z, a fraction of 1 to 9 digits. Only a timer takes one.",
      "type": "string",
      "pattern": "^(?:19[7-9][0-9]|20[0-9]{2}|21[0-9]{2})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "DateOrWallTime": {
      "anyOf": [
        {
          "$ref": "#/definitions/DateValue"
        },
        {
          "$ref": "#/definitions/WallTimeValue"
        }
      ]
    },
    "ItemId": {
      "description": "An item's id inside its object: non-blank, at most 128 UTF-16 code units, unique in its list (uniqueness is checked by both validators, not here).",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[^\\t\\n\\u000b\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    },
