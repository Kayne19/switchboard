          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "ProgressData": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "detail": {
          "type": "string",
          "maxLength": 256
        },
        "value": {
          "type": "number"
        },
        "text": {
          "type": "string",
          "maxLength": 128
        },
        "caption": {
          "type": "string",
          "maxLength": 128
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProgressStep"
          },
          "minItems": 1,
          "maxItems": 30
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "steps"
          ]
        }
      ]
    },
    "DiagramNode": {
      "type": "object",
