{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "rootDir": "apps/frontend/src",
    "outDir": "static",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": false
  },
  "include": ["apps/frontend/src/**/*.ts"],
  "exclude": [
    "apps/frontend/src/global.d.ts",
    "apps/frontend/src/app/**",
    "apps/frontend/src/components/**",
    "apps/frontend/src/controller/**",
    "apps/frontend/src/design/**",
    "apps/frontend/src/fixtures/**",
    "apps/frontend/src/hooks/**",
    "apps/frontend/src/integration/**",
    "apps/frontend/src/primitives/**",
    "apps/frontend/src/runtime/**"
  ]
}
