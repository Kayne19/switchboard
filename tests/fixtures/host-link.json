{
  "protocol": 2,
  "welcome": {"type": "welcome", "epoch": 1, "protocol": 2, "cursors": {}},
  "commands": {
    "prompt": {
      "args": {"message": "hi"},
      "frames": [
        {"type": "event", "event": {"kind": "turn_start", "cause": "input", "turn_id": "$turn"}},
        {"type": "reply", "ok": true, "result": {"sent_as": "prompt", "turn_id": "$turn"}}
      ]
    },
    "set_model": {
      "args": {"provider": "anthropic", "model": "claude-x"},
      "frames": [
        {"type": "event", "event": {"kind": "state", "model": "anthropic/claude-x", "thinking": "medium"}},
        {"type": "reply", "ok": true, "result": {"model": "anthropic/claude-x", "thinking": "medium"}}
      ]
    },
    "kill": {
      "args": {},
      "frames": [
        {"type": "event", "event": {"kind": "session_closed", "reason": "killed"}},
        {"type": "reply", "ok": true, "result": {"killed": true}}
      ]
    },
    "detach": {
      "args": {},
      "frames": [
        {"type": "event", "event": {"kind": "session_closed", "reason": "detached"}},
        {"type": "reply", "ok": true, "result": {"detached": true}}
      ]
    }
  },
  "module_replies": [
    {
      "name": "speak delivered",
      "call": "speak",
      "http_status": 200,
      "body": {"delivered": true},
      "reply": {"status": "delivered", "reason": null, "result": {"delivered": true}},
      "skill_line": "switchboard.speak: Spoken."
    },
    {
      "name": "speak while the caller is with another session",
      "call": "speak",
      "http_status": 200,
      "body": {"delivered": false, "reason": "caller_away", "detail": "the caller is listening to another session"},
      "reply": {"status": "refused", "reason": "caller_away", "result": {"delivered": false, "reason": "caller_away", "detail": "the caller is listening to another session"}},
      "skill_line": "switchboard.speak: The caller is on other work; nothing was played. If it matters to them, send it with request_to_speak."
    },
    {
      "name": "display from a leg off the call",
      "call": "display",
      "http_status": 409,
      "body": {"delivered": false, "code": "invalid_leg", "detail": "this leg is no longer on the call: stop retrying, nothing you send reaches the caller"},
      "reply": {
        "status": "refused",
        "reason": "this leg is no longer on the call: stop retrying, nothing you send reaches the caller",
        "result": {"delivered": false, "code": "invalid_leg", "detail": "this leg is no longer on the call: stop retrying, nothing you send reaches the caller"}
      }
    }
  ]
}
